# FinOps Cost Analyzer — example configuration.
# Copy to .env and edit. Every variable is optional; defaults are safe.
# NO secrets are required: this tool reads billing CSVs locally and makes
# zero network calls.

# Label shown on reports (also settable per-run with --client).
FINOPS_CLIENT_NAME=Client

# Anomaly threshold: flag days where daily spend exceeds mean + N std-devs
# (also settable per-run with --threshold).
FINOPS_THRESHOLD_STD=2.0

# Rows shown in top-N tables (also settable per-run with --top-n).
FINOPS_TOP_N=5

# Default report format: text | markdown | html (also settable per-run with --format).
FINOPS_FORMAT=text

# Directory used when --format is markdown/html and no --output is given.
FINOPS_OUTPUT_DIR=reports
